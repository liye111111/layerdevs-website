---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="LayerDevs — Focused software for commerce" description="LayerDevs builds focused tools that make complex commerce operations easier to understand and manage.">
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Independent software studio</p>
        <h1 class="display">Calm tools for complex commerce.</h1>
        <p class="lede">LayerDevs builds focused software that helps merchants understand, organize, and protect the resources behind their storefronts.</p>
        <div class="actions">
          <a class="button" href="/apps/file-explorer">Explore File Explorer <span aria-hidden="true">↗</span></a>
          <a class="button secondary" href="mailto:support@layerdevs.com">Contact us</a>
        </div>
      </div>
      <div class="orbit" aria-label="Illustration of organized commerce resources">
        <span class="orbit-label">STORE RESOURCES</span>
        <div class="file file-a"><i></i><b>Product media</b><small>Organized</small></div>
        <div class="file file-b"><i></i><b>Brand assets</b><small>Backed up</small></div>
        <div class="file file-c"><i></i><b>Documents</b><small>Ready</small></div>
        <div class="core">L</div>
      </div>
    </div>
  </section>

  <section class="section product-section">
    <div class="container">
      <p class="eyebrow">Our product</p>
      <h2 class="section-heading">A clearer way to work with Shopify files.</h2>
      <a class="product-panel" href="/apps/file-explorer">
        <div>
          <span class="product-number">01</span>
          <h3>File Explorer</h3>
          <p>Organize files with vFolders, inspect usage, export selected resources, and create downloadable backups without changing their native Shopify location.</p>
        </div>
        <div class="product-arrow" aria-hidden="true">↗</div>
      </a>
    </div>
  </section>

  <section class="section principles">
    <div class="container">
      <p class="eyebrow">How we build</p>
      <div class="principle-grid">
        <article><span>01</span><h3>Focused by default</h3><p>Each product starts with a narrow operational problem and stays understandable as it grows.</p></article>
        <article><span>02</span><h3>Merchant-controlled</h3><p>Actions are explicit, progress is visible, and exported data remains available to the merchant.</p></article>
        <article><span>03</span><h3>Built for trust</h3><p>We minimize permissions, document data handling, and design around Shopify’s platform conventions.</p></article>
      </div>
    </div>
  </section>

  <section class="section contact-band">
    <div class="container band-inner">
      <div><p class="eyebrow">Get in touch</p><h2>Questions about File Explorer?</h2></div>
      <a class="button" href="mailto:support@layerdevs.com">support@layerdevs.com</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: 90px 0 110px; overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; align-items: center; gap: 64px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .orbit { position: relative; aspect-ratio: 1; border: 1px solid var(--line); border-radius: 50%; background: radial-gradient(circle at center, #fffdf8 0 16%, transparent 16.5%), repeating-radial-gradient(circle at center, transparent 0 23%, rgba(37,87,214,.1) 23.2% 23.6%, transparent 24% 37%); box-shadow: var(--shadow); }
  .orbit-label { position: absolute; top: 8%; left: 50%; translate: -50%; color: var(--muted); font-size: .68rem; font-weight: 800; letter-spacing: .16em; }
  .core { position: absolute; inset: 50% auto auto 50%; display: grid; width: 74px; height: 74px; translate: -50% -50%; place-items: center; border-radius: 22px 8px 22px 8px; background: var(--blue); color: white; font-size: 2rem; font-weight: 900; box-shadow: 0 16px 30px rgba(37,87,214,.3); }
  .file { position: absolute; width: 154px; padding: 15px; border: 1px solid var(--line); border-radius: 15px; background: var(--surface); box-shadow: 0 10px 30px rgba(21,34,56,.1); }
  .file i { display: block; width: 30px; height: 24px; margin-bottom: 12px; border-radius: 5px; background: var(--mint); }
  .file b, .file small { display: block; }
  .file b { font-size: .84rem; }
  .file small { margin-top: 4px; color: var(--muted); }
  .file-a { top: 17%; left: -3%; rotate: -5deg; }
  .file-b { top: 25%; right: -8%; rotate: 5deg; }
  .file-b i { background: var(--coral); }
  .file-c { bottom: 9%; left: 28%; rotate: 2deg; }
  .file-c i { background: #b9c8f1; }
  .product-section { border-block: 1px solid var(--line); background: #efece4; }
  .product-panel { display: grid; grid-template-columns: 1fr auto; gap: 28px; padding: clamp(28px, 5vw, 64px); border: 1px solid var(--ink); border-radius: 26px; background: var(--surface); text-decoration: none; box-shadow: 8px 8px 0 var(--ink); transition: translate .2s ease, box-shadow .2s ease; }
  .product-panel:hover { translate: 4px 4px; box-shadow: 4px 4px 0 var(--ink); }
  .product-number { color: var(--blue); font-weight: 850; }
  .product-panel h3 { margin: 18px 0 12px; font-size: clamp(2rem, 5vw, 4.7rem); letter-spacing: -.05em; }
  .product-panel p { max-width: 700px; margin: 0; color: var(--muted); font-size: 1.08rem; line-height: 1.7; }
  .product-arrow { align-self: center; font-size: 3rem; }
  .principle-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); }
  .principle-grid article { padding: 34px 28px 10px 0; }
  .principle-grid article + article { padding-left: 28px; border-left: 1px solid var(--line); }
  .principle-grid span { color: var(--blue); font-size: .8rem; font-weight: 800; }
  .principle-grid h3 { margin: 42px 0 12px; font-size: 1.35rem; }
  .principle-grid p { color: var(--muted); line-height: 1.7; }
  .contact-band { background: var(--mint); }
  .band-inner { display: flex; align-items: end; justify-content: space-between; gap: 30px; }
  .band-inner h2 { max-width: 700px; margin: 0; font-size: clamp(2.2rem, 6vw, 5rem); line-height: 1; letter-spacing: -.05em; }
  @media (max-width: 850px) {
    .hero-grid { grid-template-columns: 1fr; }
    .orbit { width: min(560px, 95%); margin: 20px auto 0; }
    .principle-grid { grid-template-columns: 1fr; }
    .principle-grid article + article { padding-left: 0; border-left: 0; border-top: 1px solid var(--line); }
    .band-inner { align-items: flex-start; flex-direction: column; }
  }
</style>
